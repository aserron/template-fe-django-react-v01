{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Django: Runserver (apps/backend)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/apps/backend/manage.py",
      "cwd": "${workspaceFolder}/apps/backend",
      "args": ["runserver", "8000"],
      "django": true,
      "justMyCode": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Python: Pytest (apps/backend)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "args": ["-v"],
      "justMyCode": true
    }
  ]
}
