{
  "name": "demo-fe-django-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @demo/web dev",
    "dev:backend": "uv run --package demo-backend python apps/backend/manage.py runserver 8000",
    "build:web": "pnpm --filter @demo/web build",
    "typecheck:ts": "pnpm -r run typecheck",
    "typecheck:py": "uv run pyrefly check",
    "typecheck": "pnpm run typecheck:ts && pnpm run typecheck:py",
    "lint:py": "uv run ruff check .",
    "format:py": "uv run ruff format .",
    "test:py": "uv run pytest"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
